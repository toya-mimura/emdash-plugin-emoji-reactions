{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "reactions",
	// Atmosphere (Bluesky) account @toya-mimura.bsky.social
	"publisher": "did:plc:rxq2ufvjf7l5fq2jirhgvvuw",

	"license": "MIT",
	"author": { "name": "may", "url": "https://bsky.app/profile/toya-mimura.bsky.social" },
	// GitHub private vulnerability reporting (Settings > Security で有効化が必要)
	"security": { "url": "https://github.com/toya-mimura/emdash-plugin-emoji-reactions/security/advisories/new" },
	"repo": "https://github.com/toya-mimura/emdash-plugin-emoji-reactions",
	"name": "Reactions",
	"description": "Emoji reaction buttons for posts (one vote per reader).",
	"keywords": ["reactions", "like", "emoji"],

	// Trust contract
	// 外部通信もコンテンツ読み取りも不要。プラグイン専用のstorage/settings/kvだけを使う。
	"capabilities": [],
	"allowedHosts": [],
	"storage": {
		// 記事ごとの集計: id = contentId
		"counts": { "indexes": ["total", "updatedAt"] },
		// 誰がどれを押したか: id = `${contentId}:${voterHash}`
		"votes": { "indexes": ["contentId", ["contentId", "reaction"]] },
	},

	"admin": {
		"pages": [{ "path": "/reactions", "label": "Reactions", "icon": "heart" }],
	},
}
