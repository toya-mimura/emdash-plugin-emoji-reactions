{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "reactions",
	// Atmosphere (Bluesky) account @toya-mimura.bsky.social
	"publisher": "did:plc:rxq2ufvjf7l5fq2jirhgvvuw",

	"license": "MIT",
	"author": { "name": "toya", "url": "https://bsky.app/profile/toya-mimura.bsky.social" },
	// GitHub private vulnerability reporting (Settings > Security で有効化が必要)
	"security": { "url": "https://github.com/toya-mimura/emdash-plugin-emoji-reactions/security/advisories/new" },
	"repo": "https://github.com/toya-mimura/emdash-plugin-emoji-reactions",
	// Registry card. 公開後の変更は `pnpm exec emdash-plugin update-package` で反映（publish では更新されない）
	"name": "Emoji Reactions",
	"description": "Emoji reaction buttons for your posts. One reaction per reader, optional counts, no cookies and no raw IPs stored.",
	"keywords": ["reactions", "emoji", "like", "feedback", "privacy"],

	// Trust contract
	// 外部通信もコンテンツ読み取りも不要。プラグイン専用のstorage/settings/kvだけを使う。
	"capabilities": [],
	"allowedHosts": [],
	"storage": {
		// 記事ごとの集計: id = contentId
		"counts": { "indexes": ["total", "updatedAt"] },
		// 誰がどれを押したか: id = `${contentId}:${voterHash}`
		"votes": { "indexes": ["contentId", ["contentId", "reaction"]] },
	},

	"admin": {
		"pages": [{ "path": "/reactions", "label": "Reactions", "icon": "heart" }],
	},

	"sections": {
		"description":  { "file": "./docs/description.md" },   // 機能・プライバシーの要点
		"installation": { "file": "./docs/installation.md" },  // 手順1〜3（Reactions.astroの追加を強調）
		"faq":          { "file": "./docs/faq.md" },           // ボタンが出ない時（CSRF_REJECTED）、同一IPの扱いなど
		"changelog":    { "file": "./docs/changelog.md" },     // バージョンごとの変更点
		"security":     { "file": "./docs/security.md" }       // 脆弱性の報告先・扱うデータ・公開ルート
	},

	"release": {
		"artifacts": { "icon": { "file": "./icon.png" } }
	},
}
