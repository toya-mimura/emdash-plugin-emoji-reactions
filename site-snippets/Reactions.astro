---
/**
 * Reaction buttons for a post page (reactions plugin).
 * 記事ページに置くリアクションボタン（reactions プラグイン用）
 *
 * Usage in a post template:
 *   import Reactions from "../components/Reactions.astro";
 *   <Reactions contentId={post.data.id} />
 *
 * Pass the database ID (`post.data.id`), not `post.id`: `post.id` is the slug,
 * which changes when a post is renamed and contains "/" for translations.
 *
 * Buttons are configured in the plugin's admin page (sidebar > Reactions).
 */
interface Props {
	contentId: string;
	/** Heading above the buttons. Empty string hides it. */
	heading?: string;
	/** Accessible name for the button group. */
	label?: string;
}
const { contentId, heading = "Leave a reaction", label = "Reactions" } = Astro.props;
---

<emdash-reactions data-content-id={contentId}>
	{heading && <p class="rx-heading">{heading}</p>}
	<div class="rx-buttons" role="group" aria-label={label}>
		<span class="rx-loading">…</span>
	</div>
</emdash-reactions>

<script>
	const API = "/_emdash/api/plugins/reactions";

	type Reaction = { key: string; emoji: string; label: string; count?: number };
	type Display = { labels: boolean; counts: boolean };
	type State = {
		ok: boolean;
		error?: string;
		reactions: Reaction[];
		total?: number;
		mine: string | null;
		/** Set in the plugin's admin page. Missing on plugin versions before 0.2.0. */
		display?: Display;
	};

	/** Anonymous ID for environments without a client IP (local dev) */
	function visitorId(): string | undefined {
		try {
			let id = localStorage.getItem("rx-visitor");
			if (!id) {
				id = crypto.randomUUID();
				localStorage.setItem("rx-visitor", id);
			}
			return id;
		} catch {
			return undefined;
		}
	}

	async function call(path: string, init?: RequestInit): Promise<State | null> {
		const route = path.split("?")[0];
		try {
			const res = await fetch(`${API}/${path}`, init);
			const body = (await res.json().catch(() => null)) as {
				success?: boolean;
				data?: State;
				error?: { code?: string; message?: string };
			} | null;
			if (!res.ok) {
				const err = body?.error;
				console.warn(`[reactions] ${route}: HTTP ${res.status}`, err?.code ?? "", err?.message ?? "");
				return null;
			}
			if (!body?.data?.ok) {
				console.warn(`[reactions] ${route}:`, body?.data?.error ?? "unexpected response");
				return null;
			}
			return body.data;
		} catch (error) {
			console.warn(`[reactions] ${route}: request failed`, error);
			return null;
		}
	}

	class EmDashReactions extends HTMLElement {
		#box = this.querySelector<HTMLDivElement>(".rx-buttons")!;
		#busy = false;

		async connectedCallback() {
			const contentId = this.dataset.contentId!;
			const q = new URLSearchParams({ contentId });
			const vid = visitorId();
			if (vid) q.set("visitorId", vid);
			const state = await call(`state?${q}`);
			if (state) this.#render(state);
			else this.hidden = true; // plugin missing or failing: hide (reason is logged above)
		}

		#render(state: State) {
			const showLabels = state.display?.labels ?? false;
			const span = (cls: string, text: string, hidden = false) => {
				const el = document.createElement("span");
				el.className = cls;
				el.textContent = text;
				if (hidden) el.setAttribute("aria-hidden", "true");
				return el;
			};
			this.#box.replaceChildren(
				...state.reactions.map((r) => {
					const btn = document.createElement("button");
					btn.type = "button";
					btn.className = "rx-btn";
					btn.setAttribute("aria-pressed", String(state.mine === r.key));
					btn.title = r.label;
					btn.append(span("rx-emoji", r.emoji, true));
					// Counts are omitted by the API when hidden in the admin page.
					if (typeof r.count === "number") btn.append(span("rx-count", String(r.count)));
					// Hidden labels stay readable for screen readers.
					btn.append(span(showLabels ? "rx-label" : "rx-sr", r.label));
					btn.addEventListener("click", () => this.#react(r.key));
					return btn;
				}),
			);
		}

		async #react(reaction: string) {
			if (this.#busy) return;
			this.#busy = true;
			this.toggleAttribute("aria-busy", true);
			const state = await call("react", {
				method: "POST",
				headers: { "Content-Type": "application/json", "X-EmDash-Request": "1" },
				body: JSON.stringify({ contentId: this.dataset.contentId, reaction, visitorId: visitorId() }),
			});
			if (state) this.#render(state);
			this.#busy = false;
			this.toggleAttribute("aria-busy", false);
		}
	}

	if (!customElements.get("emdash-reactions")) customElements.define("emdash-reactions", EmDashReactions);
</script>

<style>
	emdash-reactions {
		--rx-border: color-mix(in srgb, currentColor 18%, transparent);
		/* Override --rx-accent from your theme to match your site's accent colour. */
		--rx-active: color-mix(in srgb, var(--rx-accent, #e8508a) 16%, transparent);
		--rx-active-border: var(--rx-accent, #e8508a);
		display: block;
		margin-block: 2.5rem 1rem;
		text-align: center;
	}
	emdash-reactions[aria-busy] {
		opacity: 0.7;
	}
	.rx-heading {
		margin: 0 0 0.75rem;
		font-size: 0.9rem;
		opacity: 0.7;
	}
	.rx-buttons {
		display: inline-flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
	}
	.rx-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 44px;
		padding: 0.35rem 0.9rem;
		border: 1px solid var(--rx-border);
		border-radius: 999px;
		background: transparent;
		color: inherit;
		font: inherit;
		cursor: pointer;
		transition: transform 0.12s ease, background-color 0.12s ease, border-color 0.12s ease;
	}
	.rx-btn:hover {
		transform: translateY(-1px);
	}
	.rx-btn:active {
		transform: scale(0.95);
	}
	.rx-btn[aria-pressed="true"] {
		background: var(--rx-active);
		border-color: var(--rx-active-border);
	}
	.rx-btn:focus-visible {
		outline: 2px solid var(--rx-active-border);
		outline-offset: 2px;
	}
	.rx-emoji {
		font-size: 1.25rem;
		line-height: 1;
	}
	.rx-label {
		font-size: 0.9rem;
	}
	.rx-count {
		font-variant-numeric: tabular-nums;
		font-size: 0.9rem;
	}
	.rx-sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
	.rx-loading {
		opacity: 0.4;
	}
	@media (prefers-reduced-motion: reduce) {
		.rx-btn {
			transition: none;
		}
	}
</style>
