---
/**
 * 記事ページに置くリアクションボタン（reactions プラグイン用）
 *
 * 使い方（記事テンプレート内）:
 *   import Reactions from "../components/Reactions.astro";
 *   <Reactions contentId={post.id} />
 *
 * ボタンの種類はプラグインの管理画面（サイドバー > Reactions）で変更できます。
 */
interface Props {
	contentId: string;
	/** ボタンの上に出す見出し（空文字で非表示） */
	heading?: string;
}
const { contentId, heading = "この記事どうでした？" } = Astro.props;
---

<emdash-reactions data-content-id={contentId}>
	{heading && <p class="rx-heading">{heading}</p>}
	<div class="rx-buttons" role="group" aria-label="リアクション">
		<span class="rx-loading">…</span>
	</div>
</emdash-reactions>

<script>
	const API = "/_emdash/api/plugins/reactions";

	type Reaction = { key: string; emoji: string; label: string; count: number };
	type State = { ok: boolean; error?: string; reactions: Reaction[]; total: number; mine: string | null };

	/** IPが取れない環境（ローカル開発）用の匿名ID */
	function visitorId(): string | undefined {
		try {
			let id = localStorage.getItem("rx-visitor");
			if (!id) {
				id = crypto.randomUUID();
				localStorage.setItem("rx-visitor", id);
			}
			return id;
		} catch {
			return undefined;
		}
	}

	async function call(path: string, init?: RequestInit): Promise<State | null> {
		try {
			const res = await fetch(`${API}/${path}`, init);
			if (!res.ok) return null;
			const body = (await res.json()) as { success?: boolean; data?: State };
			return body.data?.ok ? body.data : null;
		} catch {
			return null;
		}
	}

	class EmDashReactions extends HTMLElement {
		#box = this.querySelector<HTMLDivElement>(".rx-buttons")!;
		#busy = false;

		async connectedCallback() {
			const contentId = this.dataset.contentId!;
			const q = new URLSearchParams({ contentId });
			const vid = visitorId();
			if (vid) q.set("visitorId", vid);
			const state = await call(`state?${q}`);
			if (state) this.#render(state);
			else this.hidden = true; // プラグイン未導入などのときは静かに隠す
		}

		#render(state: State) {
			this.#box.replaceChildren(
				...state.reactions.map((r) => {
					const btn = document.createElement("button");
					btn.type = "button";
					btn.className = "rx-btn";
					btn.setAttribute("aria-pressed", String(state.mine === r.key));
					btn.title = r.label;
					btn.innerHTML = `<span class="rx-emoji" aria-hidden="true"></span><span class="rx-count"></span><span class="rx-sr"></span>`;
					btn.querySelector(".rx-emoji")!.textContent = r.emoji;
					btn.querySelector(".rx-count")!.textContent = String(r.count);
					btn.querySelector(".rx-sr")!.textContent = r.label;
					btn.addEventListener("click", () => this.#react(r.key));
					return btn;
				}),
			);
		}

		async #react(reaction: string) {
			if (this.#busy) return;
			this.#busy = true;
			this.toggleAttribute("aria-busy", true);
			const state = await call("react", {
				method: "POST",
				headers: { "Content-Type": "application/json", "X-EmDash-Request": "1" },
				body: JSON.stringify({ contentId: this.dataset.contentId, reaction, visitorId: visitorId() }),
			});
			if (state) this.#render(state);
			this.#busy = false;
			this.toggleAttribute("aria-busy", false);
		}
	}

	if (!customElements.get("emdash-reactions")) customElements.define("emdash-reactions", EmDashReactions);
</script>

<style>
	emdash-reactions {
		--rx-border: color-mix(in srgb, currentColor 18%, transparent);
		--rx-active: color-mix(in srgb, #e8508a 16%, transparent);
		--rx-active-border: #e8508a;
		display: block;
		margin-block: 2.5rem 1rem;
		text-align: center;
	}
	emdash-reactions[aria-busy] {
		opacity: 0.7;
	}
	.rx-heading {
		margin: 0 0 0.75rem;
		font-size: 0.9rem;
		opacity: 0.7;
	}
	.rx-buttons {
		display: inline-flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
	}
	.rx-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 44px;
		padding: 0.35rem 0.9rem;
		border: 1px solid var(--rx-border);
		border-radius: 999px;
		background: transparent;
		color: inherit;
		font: inherit;
		cursor: pointer;
		transition: transform 0.12s ease, background-color 0.12s ease, border-color 0.12s ease;
	}
	.rx-btn:hover {
		transform: translateY(-1px);
	}
	.rx-btn:active {
		transform: scale(0.95);
	}
	.rx-btn[aria-pressed="true"] {
		background: var(--rx-active);
		border-color: var(--rx-active-border);
	}
	.rx-btn:focus-visible {
		outline: 2px solid var(--rx-active-border);
		outline-offset: 2px;
	}
	.rx-emoji {
		font-size: 1.25rem;
		line-height: 1;
	}
	.rx-count {
		font-variant-numeric: tabular-nums;
		font-size: 0.9rem;
	}
	.rx-sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
	.rx-loading {
		opacity: 0.4;
	}
	@media (prefers-reduced-motion: reduce) {
		.rx-btn {
			transition: none;
		}
	}
</style>
